---
import { useI18n, type Locale } from '../i18n/utils';
import { site } from '../data/site';
import Pencil from './Pencil.astro';
import { stripLoop, arrow } from './marks';
interface Props { locale: Locale }
const { locale } = Astro.props;
const { d, t } = useI18n(locale);
const [p1, ...rest] = site.projects;
const i1 = d.work.items[0];
const look = (client: string, label: string) => t(d.work.lookCloser, { client, label });
---
<!-- I2: recent work -->
<section class="face face--i face--p2" id="work" aria-labelledby="work-h">
  <div class="op" aria-hidden="true"><span class="op__l">{d.cover.h1a} {d.cover.h1b}.</span></div>
  <div class="fc">
    <span class="op-word" aria-hidden="true"><span class="mk-op">{d.cover.h1b}<Pencil mark={stripLoop} g="strip-small" /></span>.</span>
    <p class="kicker" aria-hidden="true"><b>4</b><span>{d.work.kicker}</span></p>
    <div class="work-head"><h2 class="h2" id="work-h">{d.work.title}</h2><p class="meta">{t(d.work.count)}</p></div>
    <article class="w1" id="work-1" aria-labelledby="w1-h">
      <button type="button" class="print print--btn" data-work="0"><span class="paper" aria-hidden="true"></span><span class="slot">{i1.slot}</span><span class="sr-only">{look(p1.client[locale], i1.label)}</span><span class="dog" aria-hidden="true"></span><i class="pc pc--tl"></i><i class="pc pc--tr"></i><i class="pc pc--bl"></i></button>
      <h3 class="w-name" id="w1-h">{p1.client[locale]}</h3>
      <p class="meta">{p1.year} · {i1.kind}</p>
      <p class="w-text">{i1.desc}</p>
      {p1.url && <p class="read"><a href={p1.url} target="_blank" rel="noopener">{d.work.read}</a><Pencil mark={arrow} g="work" class="pencil--arrow" /></p>}
    </article>
    {rest.map((p, k) => {
      const n = k + 2, it = d.work.items[k + 1];
      return (
        <article class="wrow" id={`work-${n}`} aria-labelledby={`w${n}-h`}>
          <button type="button" class="print print--btn" data-work={k + 1}><span class="paper" aria-hidden="true"></span><span class="slot">{it.slot}</span><span class="sr-only">{look(p.client[locale], it.label)}</span><span class="dog" aria-hidden="true"></span></button>
          <div><h3 class="w-name" id={`w${n}-h`}>{p.client[locale]}</h3><p class="meta">{p.year} · {it.kind}</p><p class="w-text">{it.desc}</p></div>
        </article>
      );
    })}
  </div>
  <div class="cast" aria-hidden="true"></div>
  <div class="shade" aria-hidden="true"></div>
</section>
