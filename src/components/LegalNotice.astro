---
import { useI18n, localePath, type Locale } from '../i18n/utils';
import PlainPage from './PlainPage.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const { d, t } = useI18n(locale);
---
<PlainPage locale={locale} path="mentions-legales">
  <div class="legal">
    <h1 class="h2">{d.legal.title}</h1>
    <p class="meta">{d.legal.meta}</p>
    {d.legal.sections.map((s) => (
      <>
        <h2>{s.h}</h2>
        {s.p.map((line) => <p>{t(line)}</p>)}
      </>
    ))}
    <p class="legal__back"><a class="link-drawn" href={localePath(locale)}>{d.ui.home}</a></p>
  </div>
</PlainPage>
