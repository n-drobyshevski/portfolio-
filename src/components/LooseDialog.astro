---
/* The loose print: a work thumbnail lifts off the leaflet into this dialog. Content is filled by src/scripts/leaflet.ts. */
import { useI18n, type Locale } from '../i18n/utils';
import { site } from '../data/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const { d, t } = useI18n(locale);
const p = site.projects[0];
const i = d.work.items[0];
---
<dialog class="loose" aria-labelledby="loose-h">
  <div class="loose__wrap">
    <div class="loose__print"><span class="slot" id="loose-slot">{i.slot}</span><i class="pc pc--tl"></i><i class="pc pc--tr"></i><i class="pc pc--bl"></i><i class="pc pc--br"></i></div>
    <div class="loose__card">
      <p class="meta" id="loose-meta">{p.year} · {i.kind}</p>
      <h2 id="loose-h">{p.client[locale]}</h2>
      <p id="loose-text">{i.desc}</p>
      <blockquote id="loose-quote"><p>{p.quote?.text[locale]}</p><footer>{p.quote?.by[locale]}</footer></blockquote>
      <p class="read" id="loose-read" hidden><a href="#work">{d.work.read}</a></p>
      <div class="loose__nav"><button type="button" class="loose__prev">{d.work.dialog.prev}</button><span id="loose-count">{t(d.work.dialog.count, { i: 1, n: site.projects.length })}</span><button type="button" class="loose__next">{d.work.dialog.next}</button></div>
    </div>
    <button type="button" class="loose__close">{d.work.dialog.close}</button>
  </div>
</dialog>
