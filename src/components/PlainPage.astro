---
/* A flat sheet lying on the leaflet's desk, for pages that are not the leaflet (the price list, the legal notice, 404),
   with the same furniture around it. */
import { localePath, type Locale } from '../i18n/utils';
import { site } from '../data/site';
import Desk from './Desk.astro';
interface Props {
  locale: Locale;
  /** Page path without language, used for the language links. */
  path?: string;
  /** A wider sheet, for pages with more to lay out (the price list). */
  wide?: boolean;
  /** The sheet's name, shown on the Contents card on phones. */
  here: string;
}
const { locale, path = '', wide = false, here } = Astro.props;
---
<Desk locale={locale} sheet={path} here={here} />
<main class:list={['plain-wrap', { 'plain--wide': wide }]} id="top">
  <div class="sheet">
    <section class="face">
      <div class="fc">
        <p class="plain-mast"><a href={localePath(locale)}>{site.name}</a></p>
        <slot />
      </div>
    </section>
  </div>
</main>

<script>
  /* Contents: the same folded card as on the leaflet, opening up from the folio */
  const details = document.querySelector<HTMLDetailsElement>('.contents');
  const summary = details?.querySelector('summary');
  const card = details?.querySelector<HTMLElement>('.contents__card');
  if (details && summary && card) {
    const still = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    const folded = { transform: 'perspective(900px) translateY(12px) rotateX(-80deg)', opacity: 0 };
    const flat = { transform: 'none', opacity: 1 };
    const open = () => {
      details.open = true;
      if (still()) card.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 180 });
      else card.animate([folded, flat], { duration: 550, easing: 'cubic-bezier(.22, 1, .36, 1)' });
    };
    const close = () => {
      if (!details.open) return;
      if (still()) { details.open = false; return; }
      card.animate([flat, folded], { duration: 320, easing: 'cubic-bezier(.55, 0, 1, .45)', fill: 'forwards' }).onfinish = (e) => {
        details.open = false;
        (e.target as Animation).cancel();
      };
    };
    summary.addEventListener('click', (e) => { e.preventDefault(); if (details.open) close(); else open(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && details.open) { close(); summary.focus(); } });
    document.addEventListener('pointerdown', (e) => { if (details.open && !details.contains(e.target as Node)) close(); });
  }
</script>
