---
/* A flat sheet on the desk, for pages that are not the leaflet (legal notice, 404, the price list).
   An insert (the price list) lies on the leaflet's own desk, with the same furniture around it. */
import { localePath, type Locale } from '../i18n/utils';
import { site } from '../data/site';
import LangSwitch from './LangSwitch.astro';
import Desk from './Desk.astro';
interface Props {
  locale: Locale;
  /** Page path without language, used for the language links. */
  path?: string;
  /** A wider sheet, for pages with more to lay out (the price list). */
  wide?: boolean;
  /** Lay the sheet on the leaflet's desk, as a loose insert. */
  insert?: boolean;
}
const { locale, path = '', wide = false, insert = false } = Astro.props;
const hrefs = { en: localePath('en', path), fr: localePath('fr', path) };
---
{insert ? <Desk locale={locale} insert={path} /> : (
  <header class:list={['plain-top', { 'plain--wide': wide }]}>
    <a href={localePath(locale)}>{site.name}</a>
    <LangSwitch locale={locale} hrefs={hrefs} class="langs" />
  </header>
)}
<main class:list={['plain-wrap', { 'plain--wide': wide, 'plain--insert': insert }]} id="top">
  <div class="sheet">
    <section class="face">
      <div class="fc"><slot /></div>
    </section>
  </div>
</main>
