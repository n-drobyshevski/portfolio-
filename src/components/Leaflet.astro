---
/* The leaflet: eight faces on one sheet, plus the script that folds, turns and draws it. */
import { useI18n, fill, type Locale } from '../i18n/utils';
import { getImage } from 'astro:assets';
import { site } from '../data/site';
import { galleries } from '../data/gallery';
import Desk from './Desk.astro';
import Cover from './Cover.astro';
import About from './About.astro';
import Why from './Why.astro';
import Work from './Work.astro';
import How from './How.astro';
import Services from './Services.astro';
import Prices from './Prices.astro';
import Contact from './Contact.astro';
import LooseDialog from './LooseDialog.astro';
import Pencil from './Pencil.astro';
import { stripLoop } from './marks';
interface Props { locale: Locale }
const { locale } = Astro.props;
const { d, t } = useI18n(locale);

/* pop-up screenshots: resized at build time, loaded only when the dialog opens */
const shots = await Promise.all(site.projects.map(p => Promise.all((galleries[p.id] ?? []).map(async s => {
  const cap = s.caption[locale];
  if (typeof s.src === 'string') return { full: s.src, thumb: s.src, w: 1200, h: 750, fit: s.fit ?? '', cap };
  const [full, thumb] = await Promise.all([
    getImage({ src: s.src, width: Math.min(1440, s.src.width), format: 'webp', quality: 78 }),
    getImage({ src: s.src, width: 240, format: 'webp', quality: 70 }),
  ]);
  return { full: full.src, thumb: thumb.src, w: s.src.width, h: s.src.height, fit: s.fit ?? '', cap };
}))));

/* everything the script needs in the page's language, passed as JSON (no runtime language swapping) */
const data = {
  lang: locale,
  email: site.email,
  ui: {
    motionOn: d.ui.motionOn,
    motionOff: d.ui.motionOff,
    motionReduced: d.ui.motionReduced,
    marksOn: fill(d.contents.marks, { state: d.contents.on }),
    marksOff: fill(d.contents.marks, { state: d.contents.off }),
  },
  folio: d.folio.names,
  works: site.projects.map((p, i) => ({
    slot: d.work.items[i].slot,
    meta: `${p.year} · ${d.work.items[i].kind}`,
    name: p.client[locale],
    text: d.work.items[i].long,
    stack: d.work.items[i].stack,
    quote: p.quote ? { text: p.quote.text[locale], by: p.quote.by[locale] } : null,
    url: p.url ?? '',
    image: p.image ?? '',
    shots: shots[i],
  })),
  dialog: { count: d.work.dialog.count, caseStudyNote: d.work.dialog.caseStudyNote, shotLabel: d.work.dialog.shotLabel },
  contact: {
    copy: d.contact.copy,
    copied: d.contact.copied,
    selected: d.contact.selected,
    copiedLive: d.contact.copiedLive,
    selectedLive: d.contact.selectedLive,
    errName: d.contact.errName,
    errEmail: d.contact.errEmail,
    errEmailBad: d.contact.errEmailBad,
    errSend: t(d.contact.errSend),
    mailtoStatus: t(d.contact.mailtoStatus),
    sending: d.contact.sending,
    sentLive: d.contact.sentLive,
    subject: d.contact.mailSubject,
    needs: d.contact.mailNeeds,
    months: d.contact.months,
  },
};
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---
<Desk locale={locale} />

<main class="wrap" id="top">
  <div class="stage">
    <div class="camera">
      <div class="sheet">
        <div class="dsh dsh--soft" aria-hidden="true"></div>
        <div class="dsh dsh--sharp" aria-hidden="true"></div>
        <Cover locale={locale} />
        <About locale={locale} />
        <Why locale={locale} />
        <Work locale={locale} />
        <How locale={locale} />
        <Services locale={locale} />
        <Prices locale={locale} />
        <Contact locale={locale} />
        <div class="edge" aria-hidden="true"></div>
        <div class="poster-loop" aria-hidden="true"><Pencil mark={stripLoop} g="poster" /></div>
      </div>
    </div>
    <div class="scroll-hint" aria-hidden="true">{d.ui.scrollHint}</div>
  </div>
</main>
<!-- phone and tablet intro: the closed leaflet waits on the desk until the reader opens it (shown by the script) -->
<button class="unfold" type="button" hidden aria-label={d.ui.openLeaflet}>
  <span class="unfold__hint" aria-hidden="true"><svg viewBox="0 0 18 18"><path d="M2 13C5 5 11 4 15.5 9.5M15.5 9.5 11 9.6M15.5 9.5l-.2-4.4"/></svg><span class="unfold__tap">{d.ui.tapOpen}</span><span class="unfold__click">{d.ui.clickOpen}</span></span>
</button>
<!-- after the phone intro: a note that the rest of the leaflet is below (shown by the script, gone at the first scroll) -->
<p class="scroll-cue" aria-hidden="true" hidden><svg viewBox="0 0 14 14"><path d="M7 2v9M3 7.5 7 11.5l4-4"/></svg>{d.ui.scrollDown}</p>

<LooseDialog locale={locale} />

<p class="sr-only" aria-live="polite" id="live"></p>

<script is:inline type="application/json" id="leaflet-data" set:html={json}></script>
<script>
  import '../scripts/leaflet';
</script>
