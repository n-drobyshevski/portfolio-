---
/* Desk furniture: the controls and shortcuts that sit around the leaflet on the desk.
   Around a loose sheet (the price list, the legal notice, 404) the same furniture leads back into the leaflet instead of turning its pages. */
import { useI18n, localePath, fill, liveUrl, type Locale } from '../i18n/utils';
import { site } from '../data/site';
import LangSwitch from './LangSwitch.astro';
interface Props {
  locale: Locale;
  /** Page path of a loose sheet lying on the desk, e.g. "prices" ("" for 404); leave out on the leaflet itself. */
  sheet?: string;
  /** Where the reader is, shown on the phone bar (the sheet's title; the leaflet keeps it up to date itself). */
  here?: string;
}
const { locale, sheet, here } = Astro.props;
const { d, t } = useI18n(locale);
const loose = sheet !== undefined;
const home = loose ? localePath(locale) : '';
const hrefs = { en: localePath('en', sheet), fr: localePath('fr', sheet) };
const toc = [
  { href: `${home}#about`, label: d.contents.about, n: 2 },
  { href: `${home}#work`, label: d.contents.work, n: 4 },
  { href: `${home}#services`, label: d.contents.services, n: 6 },
  { href: `${home}#prices`, label: d.contents.prices, n: 7 },
  { href: `${home}#contact`, label: d.contents.contact, n: 8 },
];
---
{!loose && <button class="skip" type="button" hidden>{d.ui.skip}</button>}

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <filter id="graphite" x="-10%" y="-30%" width="120%" height="160%"><feTurbulence type="fractalNoise" baseFrequency="1.4" numOctaves="1" seed="4" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="1.7" xChannelSelector="R" yChannelSelector="G"/></filter>
</svg>

<div class="crops" aria-hidden="true">
  <svg class="c1" viewBox="0 0 30 30"><path d="M0 12H9M12 0V9"/></svg>
  <svg class="c2" viewBox="0 0 30 30"><path d="M0 12H9M12 0V9"/></svg>
  <svg class="c3" viewBox="0 0 30 30"><path d="M0 12H9M12 0V9"/></svg>
  <svg class="c4" viewBox="0 0 30 30"><path d="M0 12H9M12 0V9"/></svg>
</div>

<div class="imprint">
  <a class="imprint__name" href={loose ? home : '#cover'}>{site.name}</a>
  <p class="imprint__line">{t(d.imprintLine)}</p>
</div>

<div class="controls">
  <LangSwitch locale={locale} hrefs={hrefs} />
  {!loose && <button type="button" class="motion" aria-pressed="true"><span>{d.ui.motionLabel}</span>&nbsp;<b>{d.ui.motionOn}</b></button>}
</div>

<nav class="furn" aria-label={d.ui.shortcuts}>
  <a class="tag tag--work" href={`${home}#work`}><span class="tag__shadow" aria-hidden="true"></span><span class="tag__card">{d.nav.work}</span></a>
  <a class="tag tag--prices" href={sheet === 'prices' ? '#top' : `${home}#prices`} aria-current={sheet === 'prices' ? 'page' : undefined}><span class="tag__shadow" aria-hidden="true"></span><span class="tag__card">{d.nav.prices}</span></a>
  <a class="stamp" href={`${home}#contact`}>
    <svg class="stamp__ink" viewBox="0 0 108 108" aria-hidden="true" focusable="false">
      <defs><path id="stamp-ring" d="M54 54m-40.5 0a40.5 40.5 0 1 1 81 0a40.5 40.5 0 1 1-81 0"/></defs>
      <circle cx="54" cy="54" r="51" stroke-width="2.4"/><circle cx="54" cy="54" r="47" stroke-width="1"/><circle cx="54" cy="54" r="32" stroke-width="1.2"/>
      <text><textPath href="#stamp-ring" textLength="250" lengthAdjust="spacing">{d.nav.stampRing}</textPath></text>
    </svg>
    <span class="stamp__txt">{d.nav.quote}</span>
    <span class="stamp__short">{d.nav.quoteShort}</span>
  </a>
  <p class="furn__here">{here ?? `1 · ${d.folio.names.cover}`}</p>
  <div class="folio">
    {loose ? (
      <a class="folio__back" href={sheet === 'prices' ? `${home}#prices` : home} aria-label={d.ui.backToLeaflet}><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M9 2 4 7l5 5"/></svg><span>{d.ui.leaflet}</span></a>
    ) : (
      <>
        <button class="folio__btn folio__prev" type="button" aria-label={d.ui.prevPage}><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M9 2 4 7l5 5"/></svg></button>
        <p class="folio__label"><span class="folio__pg"><span>{d.folio.page}</span> <b class="odo"><span class="odo__d">1</span></b> <span>{d.folio.of}</span> · </span><b class="folio__name">{d.folio.names.cover}</b></p>
        <button class="folio__btn folio__next" type="button" aria-label={d.ui.nextPage}><svg viewBox="0 0 14 14" aria-hidden="true"><path d="m5 2 5 5-5 5"/></svg></button>
      </>
    )}
    <details class="contents">
      <summary><svg viewBox="0 0 14 10" aria-hidden="true"><path d="M0 1h14M0 5h14M0 9h9"/></svg><span>{d.contents.title}</span></summary>
      <div class="contents__card">
        <p class="contents__h">{d.contents.title}</p>
        <ol class="toc">
          {toc.map((i) => <li><a href={i.href}><span class="t">{i.label}</span><span class="lead" aria-hidden="true"></span><span class="n">{i.n}</span></a></li>)}
        </ol>
        <div class="contents__opts">
          <button type="button" class="marks-toggle" aria-pressed="true">{fill(d.contents.marks, { state: d.contents.on })}</button>
          {site.socials.map((s) => <a href={liveUrl(s.url)}>{s.name}</a>)}
          <a href={localePath(locale, 'mentions-legales')} lang={locale === 'en' ? 'fr' : undefined}>{d.contents.legal}</a>
        </div>
      </div>
    </details>
  </div>
</nav>
